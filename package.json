{
  "name": "stealthbrowser",
  "productName": "StealthBrowser",
  "version": "1.0.0",
  "description": "Open-source anti-detect browser. Multi-profile, local-only fingerprint masking and proxy management for Chrome, Edge, Brave and Firefox. 100% offline — no cloud services.",
  "author": "StealthBrowser Contributors",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "build:extension": "tsx scripts/build-extension.ts",
    "test:generator": "tsx scripts/test-generator.ts",
    "test:extension": "tsx scripts/test-extension-dom.ts",
    "selftest": "electron-vite build && electron . --selftest --no-sandbox",
    "selftest:node": "tsx scripts/selftest.ts",
    "pack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "npm run build && electron-builder --win portable",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "io.github.stealthbrowser.app",
    "productName": "StealthBrowser",
    "copyright": "Copyright (c) 2026 StealthBrowser Contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "src/extension/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/extension",
        "to": "extension"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "StealthBrowser-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StealthBrowser"
    },
    "portable": {
      "artifactName": "StealthBrowser-${version}-portable.exe"
    }
  }
}
